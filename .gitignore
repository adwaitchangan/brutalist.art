# Kokoro model weights (~340MB — over GitHub's 100MB file limit).
# ./setup --install downloads them; or fetch manually from
# github.com/thewh1teagle/kokoro-onnx releases (model-files-v1.0).
runtime/models/kokoro/*.onnx
runtime/models/kokoro/*.bin

# per-machine / regenerable
node_modules/
runtime/remotion/node_modules/
__pycache__/
*.pyc
.DS_Store
_qc/

# editor / script backups
*.bak
*.bak-*

# abandoned agent worktree (a full copy of this repo — never a commit)
.claude/worktrees/

# stale git index.lock files: this tree is sometimes reached over a mount that
# refuses unlink(), so git cannot clean up its own lock and every later write
# fails with "Unable to create index.lock". Move the lock here, don't commit it.
_stale_git_locks/

# strip_spark.py's pre-strip safety copy — reversibility scaffolding, not source
runtime/remotion/.spark-strip-backup/

# pre-edit safety copies
*.pre-spec-fix

# local keys — never commit
.env
