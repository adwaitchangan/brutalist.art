## 7. trace_logo.py flags (no execution — read-only inspection)
usage: trace_logo.py [-h] --name NAME --out OUT [--threshold THRESHOLD]
                     [--scale SCALE] [--min-area MIN_AREA] [--pad PAD]
                     [--roles ROLES]
                     image

positional arguments:
  image

options:
  -h, --help            show this help message and exit
  --name NAME           export prefix, e.g. medhavy -> MEDHAVY_PARTS
  --out OUT
  --threshold THRESHOLD
                        ink is darker than this (0-255)
  --scale SCALE         upsample before tracing
  --min-area MIN_AREA   drop components smaller than this
  --pad PAD             padding around the ink, pre-upsample
  --roles ROLES         names for largest, second-largest, and the rest

