          "props": {
            "greeting": "Bula, Liam",
            "topic": "BRUTALIST · SKILL: RIFF",
            "segment": "The riff Skill",
            "command": "I have a Remotion scene that just rendered. Before I write a single word of commentary, what does the riff skill tell me to do?",
