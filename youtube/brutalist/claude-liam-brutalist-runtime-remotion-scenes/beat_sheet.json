    {
      "beat_id": "B04",
      "act": "THE RENDER CORE",
      "lane": "BODY",
      "narration_text": "render_beat builds this command. npx remotion render, the entry point, the composition name, a temp candidate path, and three quality flags. Scale two supersamples the 1920 by 1080 composition to true 4K. Image-format png removes Remotion's default JPEG quality ceiling on flat brand color. CRF sixteen gives a clean master. Props are written to a temp file and passed with --props.",
      "engine": "kokoro",
      "voice": "am_onyx",
      "estimated_duration_s": 24,
      "audio_file": "mp3/beat-B04.mp3",
      "shot": {
