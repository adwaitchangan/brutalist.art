    {
      "beat_id": "B05",
      "act": "MATCHING THE AUDIO CLOCK",
      "lane": "BODY",
      "narration_text": "Remotion compositions end when the animation ends — at a fixed frame count. Audio beats can be longer. Without intervention, compile.py would slow-motion stretch a short clip to fill extra time. extend_clip_to_duration prevents that: it appends freeze-frames by cloning the last frame with ffmpeg's tpad filter, holding the clip exactly as long as the measured audio duration.",
      "engine": "kokoro",
      "voice": "am_onyx",
      "estimated_duration_s": 23,
      "audio_file": "mp3/beat-B05.mp3",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "scene_type": "CODE",
        "show": [
          {
            "at": "0.00",
            "event": "Code card slides in, filename extend_clip_to_duration.py"
          },
          {
            "at": "0.15",
            "event": "ffmpeg command lines reveal"
          },
          {
            "at": "0.45",
            "event": "tpad=stop_mode=clone line visible — freeze mechanism"
          },
          {
            "at": "0.65",
            "event": "-t duration line visible — holds to exact length"
          }
        ],
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "extend_clip_to_duration.py — freeze-hold",
            "code": "cmd = [FFMPEG, \"-y\", \"-i\", str(out),\n       \"-vf\",\n       f\"tpad=stop_mode=clone\"\n       f\":stop_duration={duration_s:.3f}\",\n       \"-t\", f\"{duration_s:.3f}\",\n       \"-c:v\", \"libx264\",\n       \"-preset\", \"medium\",\n       \"-crf\", \"12\",\n       \"-pix_fmt\", \"yuv420p\",\n       str(tmp)]",
            "sparkLine": "Freeze, don't stretch."
          },
          "rendered": {
            "out": "media/B05.mp4",
            "at": "2026-09-14T06:28:34.658090+00:00"
          }
        }
      },
      "actual_duration_s": 20.99,
      "render_duration_s": 21.0,
      "build": {
