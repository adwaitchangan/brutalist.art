Fixture source           ->  nbb variant
audience: "Brutalist"    ->  audience: "NikBearBrown"
palette: "claude"        ->  palette: "teardown"
                         +  register: "Teardown"
                         +  outro_source: "AUTHOR.MD :: NikBearBrown"
