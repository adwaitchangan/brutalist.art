      "props": {
        "title": "chapters/03/missing.py",
        "code": "def missing(surface, required):\n    if surface not in SURFACES:\n        raise ValueError(\"Unknown teaching surface\")\n    return sorted(set(required) - SURFACES[surface])",
        "sparkLine": "M = R \\ C. The arithmetic cannot authenticate its inputs.",
        "codeSize": 0.048,
        "sparkSize": 26
      },
      "intent": "Code card in Claude cream skin showing the missing() function; spark line names the arithmetic and its limit."
    },
