      "beat": "B13",
      "pattern": "ClaudeCodeBeat",
      "props": {
        "title": "chapters/03/classify.py",
        "code": "def classify(events):\n    allowed = {\"reason\", \"read\", \"write\"}\n    if set(events) - allowed:\n        raise ValueError(\"Unknown event\")\n    if \"write\" in events:\n        return \"agent\"\n    return \"assistant\" if \"read\" in events else \"chat\"",
        "sparkLine": "Write wins. Then read. Then default to chat.",
        "codeSize": 0.048,
        "sparkSize": 26
      },
      "intent": "Code card in Claude cream skin showing the classify() function; spark line names the priority."
    }
