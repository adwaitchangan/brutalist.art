        "title": "lessons/09/main.py",
        "code": "def sigmoid(x):\n    if x >= 0:\n        return 1 / (1 + math.exp(-x))\n    e = math.exp(x)\n    return e / (1 + e)\n\ndef loss(data, w, b):\n    return sum(max(w*x+b, 0) - y*(w*x+b)\n               + math.log1p(math.exp(-abs(w*x+b)))\n               for x, y in data) / len(data)",
        "sparkLine": "Overflow-safe sigmoid. Overflow-safe loss.",
        "codeSize": 0.048,
        "sparkSize": 28
      },
      "intent": "Onda-style code card in Claude cream skin: sigmoid + loss from lesson 9."
    },
    {
      "beat": "B09",
      "pattern": "ClaudeCodeBeat",
      "props": {
        "title": "lessons/09/main.py",
        "code": "def train(data, steps=200, rate=.2):\n    if not data or any(not math.isfinite(x) or y not in (0,1) for x,y in data):\n        raise ValueError(\"Need finite features and binary labels\")\n    if type(steps) is not int or steps < 1 or not math.isfinite(rate) or rate <= 0:\n        raise ValueError(\"Positive training budget and rate required\")\n    w = b = 0.0\n    history = [loss(data, w, b)]\n    for _ in range(steps):\n        errors = [(sigmoid(w*x+b)-y, x) for x, y in data]\n        w -= rate * sum(e*x for e, x in errors) / len(data)\n        b -= rate * sum(e for e, _ in errors) / len(data)\n    history.append(loss(data, w, b))\n    return {\"w\": w, \"b\": b, \"loss\": history}",
        "sparkLine": "Validate. Predict. Update. Record.",
        "codeSize": 0.033,
        "sparkSize": 26
      },
      "intent": "Onda code card: train() from lesson 9 \u2014 the bounded training loop."
    }
