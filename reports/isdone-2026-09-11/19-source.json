      "props": {
        "title": "chapters/01/walk_it_forward.py",
        "code": ">>> probabilities([1, 2, 3])\n\n# peak    = 3\n# shifted = [-2, -1, 0]\n# weights = [0.1353, 0.3679, 1.0000]\n# total   \u2248 1.5032\n\n[0.09, 0.24, 0.67]     # sums to 1",
        "sparkLine": "Exponentiate. Normalize. Return a distribution.",
