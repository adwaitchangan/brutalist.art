      "props": {
        "title": "chapters/01/shift.py",
        "code": "peak = max(logits)          # 3\nshifted = [x - peak for x in logits]\n# shifted = [-2, -1, 0]\nweights = [math.exp(s) for s in shifted]\n# weights \u2248 [0.1353, 0.3679, 1.0]",
        "sparkLine": "Subtract the peak. Exponents stay small.",
