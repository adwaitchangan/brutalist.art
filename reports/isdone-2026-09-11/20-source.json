        "code": "def run(policy, records, max_turns=4):\n    if type(max_turns) is not int or max_turns < 1:\n        raise ValueError(\"Positive turn budget required\")\n    trace, it = [], iter(policy)\n    for turn in range(max_turns):\n        try: action = next(it)\n        except StopIteration: return {\"status\": \"incomplete\", \"trace\": trace}\n        name = action.get(\"name\")\n        if name == \"finish\":\n            return {\"status\": \"finished\", \"trace\": trace}\n        obs = (records.get(action.get(\"key\"), \"not found\")\n               if name == \"lookup\" else \"error: tool not allowed\")\n        trace.append({\"turn\": turn+1, \"action\": name, \"observation\": obs})\n    return {\"status\": \"budget-exhausted\", \"trace\": trace}",
