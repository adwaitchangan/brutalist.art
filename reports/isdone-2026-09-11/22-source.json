        "code": "def probabilities(logits, temperature=1.0):\n    if not logits or temperature <= 0:\n        raise ValueError(\"positive T required\")\n    peak = max(logits)\n    weights = [math.exp((x - peak) / temperature)\n               for x in logits]\n    total = sum(weights)\n    return [w / total for w in weights]",
