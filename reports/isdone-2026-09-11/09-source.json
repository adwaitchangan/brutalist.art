      "props": {
        "title": "chapters/01/inside_a_step.py",
        "code": "for layer in stack:               # ~ dozens of these\n    vecs = attention(vecs, context) # bank | river  \u2192  bank | savings\n    vecs = feed_forward(vecs)       # stored patterns applied\n\nfinal = vecs[-1]                    # last position\nscores = project(final, vocab)      # one score per token\nprobs  = softmax(scores)            # normalize into a distribution",
        "sparkLine": "Attention \u00b7 Feed-forward \u00b7 Repeat \u00b7 Normalize.",
