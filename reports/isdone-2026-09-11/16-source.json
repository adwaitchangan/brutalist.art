        "title": "chapters/02/validate.py",
        "code": "import json\n\ndef validate(text, source_ids):\n    try:\n        data = json.loads(text)\n    except (ValueError, TypeError):\n        return False\n    return (isinstance(data, dict)\n        and set(data) == {\"answer\", \"sources\"}\n        and isinstance(data[\"answer\"], str)\n        and bool(data[\"answer\"].strip())\n        and isinstance(data[\"sources\"], list)\n        and bool(data[\"sources\"])\n        and all(isinstance(s, str) and s in source_ids\n                for s in data[\"sources\"]))",
        "sparkLine": "Parse. Shape. Keys. Types. Membership.",
        "codeSize": 0.045,
        "sparkSize": 26
      },
      "intent": "The validate() function as an Onda-style code card in the Claude cream skin. Spark line names the mechanism."
    },
